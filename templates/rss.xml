{#- Overrides Zola's built-in feed, which skips pages without a top-level
    `date`. Events keep their date in `extra.date` (which may be "TBD"), so
    list every event here instead. `extra.pub_date`, when set, is when the
    event was announced and becomes the item's pubDate. -#}
{%- set events_section = get_section(path="events/_index.md") -%}
<?xml version="1.0" encoding="UTF-8"?>
<rss xmlns:atom="http://www.w3.org/2005/Atom" version="2.0">
  <channel>
    <title>{{ config.title }}</title>
    <link>{{ config.base_url | escape_xml | safe }}</link>
    <description>{{ config.description }}</description>
    <generator>Zola</generator>
    <language>{{ lang }}</language>
    <atom:link href="{{ feed_url | safe }}" rel="self" type="application/rss+xml"/>
    {%- for event in events_section.pages | sort(attribute="extra.date") %}
    <item>
      <title>{{ event.title }} ({{<event_date date={event.extra.date} style="long"/>}})</title>
      <link>{{ event.permalink | escape_xml | safe }}</link>
      <guid>{{ event.permalink | escape_xml | safe }}</guid>
      {%- if event.extra.pub_date %}
      <pubDate>{{ event.extra.pub_date | date(format="%a, %d %b %Y %H:%M:%S %z") }}</pubDate>
      {%- endif %}
      <description>{{ event.content }}</description>
    </item>
    {%- endfor %}
  </channel>
</rss>
